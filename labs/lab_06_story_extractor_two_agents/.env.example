# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# LangChain model string (provider:model). Default: openrouter:gpt-5.4
OPENROUTER_MODEL=openrouter:gpt-5.4

# Optional: override default prompts
# SYSTEM_PROMPT=You write short happy stories for kids...
# USER_PROMPT=Write a short happy story for kids about: {subject}

# Optional: audio models (text-to-speech / speech-to-text)
OPENROUTER_TTS_MODEL=
OPENROUTER_TTS_VOICE=
OPENROUTER_STT_MODEL=

PORT=3000

# Optional (tests): mock extractor response instead of calling the model
# EXTRACTOR_MOCK_RESPONSE=
