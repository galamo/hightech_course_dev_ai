# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# LangChain model string (provider:model). Default: openrouter:gpt-5.4
OPENROUTER_MODEL=openrouter:gpt-5.4

PORT=5000

# Ticket MCP server (lab_12_ticket_management_mcp/mcp-server)
MCP_URL=http://localhost:3300/mcp
# Optional, derived from MCP_URL when omitted
# MCP_AUTH_URL=http://localhost:3300/auth
